# Optional. `docker compose up` works without this file; copy it to `.env` to override a value.
# The defaults below are development-only and must not be used anywhere else.

# At least 32 characters; sent by clients in the X-API-Key header.
API_KEY=dev-only-api-key-not-for-production-use-0000
# `whsec_` followed by base64 of the signing key (the dev value decodes to 32 bytes).
WEBHOOK_SECRET=whsec_ZGV2LW9ubHktd2ViaG9vay1zaWduaW5nLWtleS0wMTI=
# Hosts that may resolve to private addresses. Keep it empty outside the demo.
WEBHOOK_INTERNAL_HOSTS=webhook-receiver,host.docker.internal

POSTGRES_PASSWORD=payments
RABBITMQ_PASSWORD=payments
LOG_LEVEL=INFO
# Messages each consumer holds unacknowledged (design section 9).
CONSUMER_PREFETCH=10

# Host ports of the published services (bound to 127.0.0.1).
API_PORT=8000
RECEIVER_PORT=9000
RABBITMQ_UI_PORT=15672
